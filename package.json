{
  "name": "active-react",
  "version": "0.1.0",
  "description": "SEO + Rust/WASM pour React 19 en ~1,3 kB : zéro effet, compatible SSR, SSG et Server Components.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "start": "node site/server.js",
    "heroku-postbuild": "npm run build && npm --prefix site ci --include=dev && npm --prefix site run build && rm -rf site/node_modules"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^30.1.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "keywords": [
    "react",
    "seo",
    "meta",
    "open-graph",
    "json-ld",
    "wasm",
    "webassembly",
    "rust",
    "wasm-bindgen",
    "ssr"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maxlestage/Active.git"
  },
  "engines": {
    "node": ">=20"
  }
}
